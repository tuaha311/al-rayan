{
  "name": "xeco-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "React islands compiled into Django static bundles (dev/build tooling only).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/tailwind.css -o ../static/css/hero.css --minify",
    "watch": "node build.mjs --watch"
  },
  "dependencies": {
    "@mux/mux-video": "^0.31.0",
    "@paper-design/shaders-react": "^0.0.46",
    "@radix-ui/react-slot": "^1.2.4",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.19"
  }
}
